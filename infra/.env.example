# ─────────────────────────────────────────────────────────────────────────────
# iPredict — one environment file for the whole production stack.
#
#   cp .env.example .env      # then fill in every value marked CHANGE ME
#
# Compose loads this file automatically for ${VAR} interpolation, and
# docker-compose.production.yml then hands each service only the variables that
# service actually reads. That is what "centralized env loading" means here: a
# variable is declared once, in this file, and every consumer resolves it from
# the same place — while RESOLVER_KEY still reaches only the aggregator and
# ORACLE_API_KEY only the API.
#
# The per-service backend/.env.example, indexer/.env.example and
# oracle/.env.example stay as they are: they are for running one service on the
# host with `npm run dev`, not for the container stack.
#
# Variable names here must match what the code parses — backend/src/config,
# indexer/src/config, oracle/src/aggregator/config.ts,
# oracle/src/monitor/config.ts and oracle/src/adapters/config.ts. A typo is not
# a startup error for anything with a default; it is a silent wrong value.
#
# .env is git-ignored. Never commit a filled-in copy; see "Secret handling" in
# infra/README.md before putting real values anywhere.
# ─────────────────────────────────────────────────────────────────────────────


# ── Postgres ─────────────────────────────────────────────────────────────────
# Used by the postgres service itself, and composed into DATABASE_URL for the
# api, indexer, oracle-aggregator and oracle-monitor services.
#
# Keep the password URL-safe (A–Z a–z 0–9 . _ ~ -). It is interpolated into a
# postgres:// URL, so @ : / ? # would have to be percent-encoded to survive.
POSTGRES_USER=ipredict
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=ipredict

# Backend connection pool (backend/src/config).
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000


# ── Redis ────────────────────────────────────────────────────────────────────
# Passed to redis-server as --requirepass and composed into REDIS_URL.
# Same URL-safety rule as the Postgres password.
REDIS_PASSWORD=your-secure-redis-password-here


# ── Stellar / Soroban ────────────────────────────────────────────────────────
# Read by the indexer and the oracle. Point these at the network the contract
# IDs below were deployed to — a testnet passphrase with mainnet contract IDs
# fails at signing time, not at startup.
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# From deploy-mainnet-output.json. The indexer refuses to start without all four.
MARKET_CONTRACT_ID=
TOKEN_CONTRACT_ID=
REFERRAL_CONTRACT_ID=
LEADERBOARD_CONTRACT_ID=


# ── API ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Leave empty to
# allow none — never set this to "*" for a credentialed API.
CORS_ORIGINS=https://ipredict.app

RATE_LIMIT_DEFAULT=30
RATE_LIMIT_WINDOW_SECONDS=60

# SECRET. Required. Guards POST /api/v1/oracle/submit. Without it the API
# accepts a hard-coded development key (backend/src/api/oracle.ts), so an
# unset value here is an open write endpoint, not a disabled one.
ORACLE_API_KEY=your-secure-oracle-api-key-here

# Oracle submissions required before the API reports a market as ready.
ORACLE_THRESHOLD=3

# One host port per API replica is taken from this range.
API_PORT_RANGE=4000-4002
API_REPLICAS=3
API_MEMORY_LIMIT=512m


# ── Indexer ──────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=5000
EVENTS_PER_PAGE=200
# Ledger to start from when there is no checkpoint. 0 = earliest available.
START_LEDGER=0
INDEXER_MEMORY_LIMIT=512m


# ── Oracle — council (Phase 1.5) ─────────────────────────────────────────────
COUNCIL_SIZE=7
COUNCIL_THRESHOLD=4
# Comma-separated council member public keys (G...).
COUNCIL_MEMBERS=

# SECRET. Signs the final resolve_market transaction. The aggregator needs it;
# the monitor deliberately does not.
RESOLVER_KEY=your-stellar-private-key-here

# Fraction (0–1) of dissenting votes that flags a conflict.
CONFLICT_THRESHOLD=0.3

SUBMIT_BASE_BACKOFF_MS=1000
SUBMIT_MAX_BACKOFF_MS=30000

# Optional webhook called when a market is finalized.
FINALIZE_WEBHOOK_URL=


# ── Oracle — optimistic oracle (Phase 2) ─────────────────────────────────────
# DISPUTER_BOND_XLM must exceed SUBMITTER_BOND_XLM or the aggregator refuses
# to start.
SUBMITTER_BOND_XLM=100
DISPUTER_BOND_XLM=200
CHALLENGE_WINDOW_SECONDS=86400
COUNCIL_WINDOW_SECONDS=259200
# Council fee in basis points of the loser's bond (1000 = 10%).
COUNCIL_FEE_BPS=1000


# ── Oracle — monitor ─────────────────────────────────────────────────────────
# How often the monitor runs a full check cycle.
MONITOR_INTERVAL_MS=60000
# Hours past expiry before an unresolved market is flagged as stuck.
STUCK_MARKET_HOURS=6
# Hours an escalated market may sit without council votes before alerting.
COUNCIL_INACTIVITY_HOURS=48
# Receives every monitor alert as JSON. Leave empty to log alerts only.
ALERT_WEBHOOK_URL=


# ── Oracle — data adapters ───────────────────────────────────────────────────
# SECRET. Optional: an adapter without a key falls back to the provider's
# unauthenticated endpoint, which is rate-limited far more aggressively.
# Names must match oracle/src/adapters/config.ts.
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
SPORTDATA_API_KEY=
THE_ODDS_API_KEY=
METACULUS_API_KEY=


# ── Operations ───────────────────────────────────────────────────────────────
# Registry and immutable tags for built images. Use a semantic version for a
# release or <branch>-<short-sha> for a branch build. Never deploy `local`.
IMAGE_REGISTRY=ghcr.io/akanimoh12
API_IMAGE_TAG=local
INDEXER_IMAGE_TAG=local
ORACLE_IMAGE_TAG=local

LOG_LEVEL=info
ORACLE_MEMORY_LIMIT=384m

# infra/scripts/backup.sh
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
