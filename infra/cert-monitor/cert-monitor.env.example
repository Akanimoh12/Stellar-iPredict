# iPredict certificate monitor — environment configuration
# Copy to /etc/ipredict/cert-monitor.env (systemd EnvironmentFile) or export
# before running check-certs.py. Every variable is optional; without any of
# them alerts are still printed to stdout/journal.

# ── Alert channels ───────────────────────────────────────────────────────────
# Chat webhook: Slack / Teams-compatible ({"text": ...}) by default.
#CERT_MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/AAA/BBB/CCC
#CERT_MONITOR_WEBHOOK_FORMAT=slack        # slack | discord | generic

# Email — used for HIGH (14d) and CRITICAL (7d/expired) alerts only.
# Needs a local sendmail or mail(1) binary on the host running the monitor.
#CERT_MONITOR_EMAIL_TO=oncall@ipredict.xyz

# External dead-man's-switch (e.g. healthchecks.io). Pinged after every
# successful run; that service alerts when the pings stop — this is what
# catches "the cron job itself died".
#CERT_MONITOR_HEARTBEAT_URL=https://hc-ping.com/<uuid>

# ── Internal certificates ────────────────────────────────────────────────────
# CA bundle used to validate internal/private-CA endpoints. Without it,
# internal endpoints still have their expiry checked, but chain verification
# is reported as "skipped".
#CERT_MONITOR_CA_FILE=/etc/ipredict/certs/internal-ca-chain.pem

# ── Paths / tuning ───────────────────────────────────────────────────────────
#CERT_MONITOR_STATE_FILE=/var/lib/ipredict-cert-monitor/state.json
