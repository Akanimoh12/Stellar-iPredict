# ── Backend API configuration ────────────────────────────────────────────────
# Copy to .env and fill in real values.

# HTTP
PORT=4000
HOST=0.0.0.0

# PostgreSQL (shared with the indexer)
DATABASE_URL=postgres://ipredict:ipredict@localhost:5432/ipredict

# Connection pool + slow-query logging (issue #417)
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# A query slower than this (ms) logs one "slow db query" line with its
# parameterised SQL and duration. Bound values are never logged.
DB_SLOW_QUERY_THRESHOLD_MS=200

# Redis cache
REDIS_URL=redis://localhost:6379

# Stellar / Soroban
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Contract IDs (from deploy-mainnet-output.json)
MARKET_CONTRACT_ID=
TOKEN_CONTRACT_ID=
REFERRAL_CONTRACT_ID=
LEADERBOARD_CONTRACT_ID=

# ── Oracle provider auth ─────────────────────────────────────────────────────
# One credential per provider, comma-separated, each binding a key to the
# provider identity it may submit for:
#
#   ORACLE_API_KEYS=<provider>:sha256$<digest>,<provider>:sha256$<digest>
#
# <provider> is the provider's Stellar public key — the same value the request
# body carries and the signature is checked against. A key may only submit for
# the provider it is bound to; using it to name another provider is a 403.
#
# Store the SHA-256 of the key, not the key: the environment then holds a
# verifier, so a leaked config dump or crash report does not hand over working
# credentials. Generate one with:
#
#   PROVIDER=GABC...XYZ
#   KEY=$(openssl rand -hex 32)
#   DIGEST=$(printf %s "$KEY" | sha256sum | cut -d' ' -f1)
#   echo "give the provider: $KEY"
#   printf '%s:sha256$%s\n' "$PROVIDER" "$DIGEST"
#
# Rotating or revoking one provider is a single entry; the others are
# untouched. Raw (unhashed) keys are accepted outside production only.
#
# Leave unset for local development and the fallback key "test-oracle-api-key"
# is accepted for any provider. Production refuses to start without real
# credentials, and refuses raw ones.
#
# The singular ORACLE_API_KEY is no longer supported — it authenticated every
# provider with one shared key, so it could not be rotated per provider and a
# submission could not be attributed. Setting it fails startup in production
# with a message naming this variable.
ORACLE_API_KEYS=

# Rate limiting defaults (requests per window-seconds)
RATE_LIMIT_DEFAULT=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Secrets source (docs/SECRETS.md) ─────────────────────────────────────────
# env (default) | env-file | vault (reserved, fails loudly).
# `<NAME>_FILE` indirection works under every backend:
#   ORACLE_API_KEYS_FILE=/run/secrets/oracle_api_keys
SECRETS_BACKEND=env
SECRETS_ENV_FILE=.env
SECRETS_ENV_FILE_REQUIRED=false

# ── Metrics (GET /metrics on $PORT) ──────────────────────────────────────────
# The API exposes api_request_duration_ms_*, api_errors_total, and the cache
# hit-rate metrics (cache_hit_rate, cache_hits_total, cache_misses_total).
# No configuration — the endpoint is always on.
