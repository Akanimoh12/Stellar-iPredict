# Copy this file to infra/.env. It is consumed by docker-compose.staging.yml.
# Do not commit a real oracle secret key or provider API key.
POSTGRES_PASSWORD=replace-with-a-staging-password
MARKET_CONTRACT_ID=
ORACLE_SECRET_KEY=

# These default to Stellar Testnet in docker-compose.staging.yml. Override only
# when using a compatible testnet RPC provider.
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# COINGECKO_API_KEY=
# BINANCE_API_KEY=
# SPORTS_API_KEY=
# ODDS_API_KEY=
