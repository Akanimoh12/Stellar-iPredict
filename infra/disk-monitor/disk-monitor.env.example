# iPredict disk-space monitor — environment configuration
# Copy to /etc/ipredict/disk-monitor.env (systemd EnvironmentFile) or export
# before running check-disk.py. Every variable is optional; without any of
# them alerts are still printed to stdout/journal.

# ── Alert channels ───────────────────────────────────────────────────────────
# Chat webhook: Slack / Teams-compatible ({"text": ...}) by default.
#DISK_MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/AAA/BBB/CCC
#DISK_MONITOR_WEBHOOK_FORMAT=slack        # slack | discord | generic

# Email — used for HIGH (7d) and CRITICAL (3d/full) alerts only.
# Needs a local sendmail or mail(1) binary on the host running the monitor.
#DISK_MONITOR_EMAIL_TO=oncall@ipredict.xyz

# External dead-man's-switch (e.g. healthchecks.io). Pinged after every
# successful run; that service alerts when the pings stop — this is what
# catches "the cron job itself died".
#DISK_MONITOR_HEARTBEAT_URL=https://hc-ping.com/<uuid>

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string for per-table growth tracking.
# Requires psql client installed on the monitor host.
# Format: postgresql://user:password@host:5432/dbname
#DISK_MONITOR_DATABASE_URL=postgresql://ipredict:secret@localhost:5432/ipredict

# ── Paths / tuning ───────────────────────────────────────────────────────────
#DISK_MONITOR_STATE_FILE=/var/lib/ipredict-disk-monitor/state.json
