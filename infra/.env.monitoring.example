# Monitoring Stack Environment Variables
# Copy this file to .env and customize as needed

# Grafana admin password (customize for security)
GRAFANA_ADMIN_PASSWORD=change-me-to-secure-password

# Alertmanager notification receivers (optional).
#
# Leave both empty for a local smoke test: Alertmanager still starts, evaluates
# the routing tree, and Prometheus reports it as a healthy Alertmanager target
# (Status -> Alertmanagers). The warning/critical receivers just POST to a
# no-op local sink until a real endpoint is configured.
#
# ALERT_WEBHOOK_URL: generic webhook (JSON). Any endpoint that accepts
#   Alertmanager webhook v2 payloads: a Slack incoming webhook, PagerDuty
#   Events API, or an internal relay. Defaults to a local no-op sink on
#   host.docker.internal:8090 when unset.
# SLACK_WEBHOOK_URL: Slack incoming-webhook URL (https://hooks.slack.com/...).
#   Critical alerts are routed to the #ipredict-alerts channel when set.
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
