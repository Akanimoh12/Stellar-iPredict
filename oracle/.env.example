# ── Oracle configuration ──────────────────────────────────────────────────────
# Copy to .env and fill in real values.

# Stellar / Soroban
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
MARKET_CONTRACT_ID=

# Oracle provider signing key (KEEP SECRET — never commit a real one)
ORACLE_SECRET_KEY=

# Council aggregator
COUNCIL_THRESHOLD=4
COUNCIL_SIZE=7

# Minimum council member submissions required before finalization (default: 4)
# Safety feature to prevent finalization based on incomplete data
# Recommended: set to COUNCIL_THRESHOLD (balanced) or COUNCIL_SIZE (strict)
MIN_REQUIRED_SUBMISSIONS=4

# Aggregator poll interval in milliseconds (default: 5000 = 5 seconds)
# How often the aggregator checks for expired unresolved markets
POLL_INTERVAL_MS=5000

# Council registry — comma-separated list of the 7 member public keys (G...)
# This also serves as the default resolver set for all categories unless overridden
COUNCIL_MEMBERS=

# Optional: Category-specific resolver overrides
# Allows different resolver sets per market category (Crypto, Sports, Politics, Entertainment, Science, Other)
# If not set, the category uses the default COUNCIL_MEMBERS set
# CATEGORY_RESOLVERS_CRYPTO=GABC...,GDEF...
# CATEGORY_RESOLVERS_SPORTS=GXYZ...,GUVW...
# CATEGORY_RESOLVERS_POLITICS=
# CATEGORY_RESOLVERS_ENTERTAINMENT=
# CATEGORY_RESOLVERS_SCIENCE=
# CATEGORY_RESOLVERS_OTHER=

# Resolver signing key used to submit the final resolve_market tx (KEEP SECRET)
RESOLVER_SECRET_KEY=

# Set only when running `npm run submit` as a council member (KEEP SECRET,
# never share — this is your own key, used only to sign your local submission)
COUNCIL_MEMBER_SECRET=

# Optimistic oracle (Phase 2)
SUBMITTER_BOND_XLM=100
DISPUTER_BOND_XLM=200

# Challenge/dispute windows (seconds)
CHALLENGE_WINDOW_SECONDS=86400
COUNCIL_WINDOW_SECONDS=259200

# Council fee — basis points of the loser's bond (1000 = 10%)
COUNCIL_FEE_BPS=1000

# Data source API keys
COINGECKO_API_KEY=
BINANCE_API_KEY=
SPORTS_API_KEY=
ODDS_API_KEY=

# Monitoring / alerting
ALERT_WEBHOOK_URL=
MARKET_UNRESOLVED_ALERT_HOURS=6
