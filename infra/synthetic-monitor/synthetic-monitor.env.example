# iPredict synthetic read-path monitor — environment configuration
# Copy to /etc/ipredict/synthetic-monitor.env (systemd EnvironmentFile) or
# export before running check-synthetic.py. Every variable is optional;
# without any of them checks still run and alerts still print to stdout/journal.

# ── Alert channels ───────────────────────────────────────────────────────────
# Chat webhook: Slack / Teams-compatible ({"text": ...}) by default.
#SYNTHETIC_MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/AAA/BBB/CCC
#SYNTHETIC_MONITOR_WEBHOOK_FORMAT=slack        # slack | discord | generic

# Email — used for HIGH (sustained slowness) and CRITICAL (repeated failures /
# watchdog gap) alerts only. Needs a local sendmail or mail(1) binary.
#SYNTHETIC_MONITOR_EMAIL_TO=oncall@ipredict.xyz

# External dead-man's-switch (e.g. healthchecks.io). Pinged after every
# successful run; that service alerts when the pings stop — this is what
# catches "the cron job itself died" when the watchdog window is set wide.
#SYNTHETIC_MONITOR_HEARTBEAT_URL=https://hc-ping.com/<uuid>

# ── Request identity ─────────────────────────────────────────────────────────
# Origin/Referer sent with every request. Defaults to each check's own origin,
# which is what the /api/rpc proxy's allowlist expects — only override this if
# ALLOWED_ORIGINS on the deployment does not include the target's own origin.
#SYNTHETIC_MONITOR_ORIGIN=https://ipredict-stellar.vercel.app

# ── Paths / tuning ───────────────────────────────────────────────────────────
#SYNTHETIC_MONITOR_STATE_FILE=/var/lib/ipredict-synthetic-monitor/state.json
