{
  "name": "ipredict-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API and indexer for iPredict",
  "main": "index.js",
  "scripts": {
    "build": "tsc --module commonjs --moduleResolution node",
    "test": "vitest run",
    "test:contract": "vitest run test/contract.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
