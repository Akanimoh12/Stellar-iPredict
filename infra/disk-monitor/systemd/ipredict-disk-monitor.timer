[Unit]
Description=Run the iPredict disk-space monitor once a day
Documentation=file:///opt/ipredict/infra/README.md

[Timer]
# Daily at 06:23 UTC, jittered so it never lands on the hour with everything
# else. Persistent=true catches up after downtime, then the monitor's own
# watchdog reports the gap.
OnCalendar=*-*-* 06:23:00
RandomizedDelaySec=20m
Persistent=true
AccuracySec=1min
Unit=ipredict-disk-monitor.service

[Install]
WantedBy=timers.target
