{
  "annotations": { "list": [] },
  "description": "Cache hit rate per key namespace on the same time axis as the database load those misses produce. Shared crosshair: hover a dip in any hit-rate panel to see the query rate, latency and pool occupancy move with it.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Windowed hit rate for each cache key namespace. A namespace that falls while the others hold is a key-shape or invalidation problem on that namespace only — the aggregate cache_hit_rate would hide it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(cache_namespace_hits_total[$__rate_interval]))\n  / clamp_min(\n      sum by (namespace) (rate(cache_namespace_hits_total[$__rate_interval]))\n      + sum by (namespace) (rate(cache_namespace_misses_total[$__rate_interval])),\n      0.01\n    )",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Hit rate by namespace",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Statements executed per second through the shared Postgres pool. This is the line that rises when a hit-rate panel falls: every lookup the cache cannot absorb becomes a query.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(db_query_duration_ms_count[$__rate_interval])",
          "legendFormat": "queries / second",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database query rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Query latency percentiles from the same histogram. A hit-rate collapse does not just add queries; it adds them on the request path, so p99 is where users feel it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_query_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_query_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Database query latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Cache lookups per second, by namespace — the denominator of the hit-rate panels. Rising volume here with a flat hit rate is growth; a flat volume with a falling hit rate is a cache problem.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(cache_namespace_hits_total[$__rate_interval]))\n  + sum by (namespace) (rate(cache_namespace_misses_total[$__rate_interval]))",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cache lookups by namespace",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Lookups that fell through to the database, by namespace. This series is the direct cause of the Database query rate panel: if one namespace's misses climb, that is the key structure to inspect.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(cache_namespace_misses_total[$__rate_interval]))",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Misses falling through to the database",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Of the lookups for resources that do not exist, what fraction was answered without touching Postgres? Tracked separately from the ordinary hit rate: a 404 storm would raise that one while burying the database in identical zero-row queries if this one collapsed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(negative_cache_hits_total[$__rate_interval]))\n  / clamp_min(\n      sum(rate(negative_cache_hits_total[$__rate_interval]))\n      + sum(rate(negative_cache_misses_total[$__rate_interval])),\n      0.01\n    )",
          "legendFormat": "negative cache",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(negative_cache_namespace_hits_total[$__rate_interval]))\n  / clamp_min(\n      sum by (namespace) (rate(negative_cache_namespace_hits_total[$__rate_interval]))\n      + sum by (namespace) (rate(negative_cache_namespace_misses_total[$__rate_interval])),\n      0.01\n    )",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Negative cache hit rate (not-found lookups)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The windowed hit rate compared with its own 6-hour baseline — the two series the CacheHitRateBelowBaseline alert evaluates. Current dropping below baseline is exactly what that alert pages on.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(cache_hits_total[10m]))\n  / clamp_min(sum(rate(cache_hits_total[10m])) + sum(rate(cache_misses_total[10m])), 0.01)",
          "legendFormat": "current (10m)",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "avg_over_time(\n    (\n      sum(rate(cache_hits_total[10m]))\n      / clamp_min(sum(rate(cache_hits_total[10m])) + sum(rate(cache_misses_total[10m])), 0.01)\n    )[6h:5m]\n  )",
          "legendFormat": "baseline (6h)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Hit rate vs its 6h baseline",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Pool saturation. Waiting connections are the point where extra misses stop being merely slower queries and start queuing requests.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 16 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "db_pool_connections_waiting",
          "legendFormat": "waiting",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "db_pool_connections_idle",
          "legendFormat": "idle",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "db_pool_connections_total",
          "legendFormat": "total",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Database connection pool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "API latency for the routes the cache fronts. The user-visible consequence of both panels above.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 16 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_ms_bucket{route=~\"GET /api/(markets|leaderboard|stats).*\"}[$__rate_interval])))",
          "legendFormat": "p99 cached routes",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "p99 all routes",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "API latency (cached routes)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ipredict", "cache", "database"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "iPredict Cache & Database Load",
  "uid": "ipredict-cache",
  "version": 1,
  "weekStart": ""
}
